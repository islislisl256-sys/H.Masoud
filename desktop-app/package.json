{
  "name": "hanoutak-desktop",
  "version": "1.0.0",
  "description": "Desktop version of the Library System",
  "main": "main.js",
  "productName": "حانوتك",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "author": "Masoud",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.masoud.library",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}