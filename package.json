{
  "name": "library-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "cap:sync": "npx cap sync",
    "build:android": "npm run build && npx cap sync android",
    "build:windows": "npm run build && npx electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@spfxappdev/docxmerger": "^1.0.3",
    "@supabase/supabase-js": "^2.111.0",
    "clsx": "^2.1.1",
    "docx-merger": "^1.2.2",
    "docxtemplater": "^3.69.3",
    "electron-serve": "^3.0.1",
    "framer-motion": "^12.43.0",
    "html2pdf.js": "^0.14.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pizzip": "^3.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "main": "main.js",
  "build": {
    "appId": "com.hmasoud.librarysystem",
    "productName": "H.Masoud System",
    "directories": {
      "output": "Windows_App_Release",
      "app": "."
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "files": [
      "out/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ]
  }
}
